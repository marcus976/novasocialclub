modules = ["web", "nodejs-20", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/index.js"]

[userenv]

[userenv.shared]
ADMIN_EMAIL = "Marcus@thenovasocialclub.com"
